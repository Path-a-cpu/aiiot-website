---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = `/${lang}`;
const nav = [
  { href: `${base}/`, label: t('nav.home') },
  { href: `${base}/about`, label: t('nav.about') },
  { href: `${base}/products`, label: t('nav.products') },
  { href: `${base}/contact`, label: t('nav.contact') },
];
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
  <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between">
    <a href={base} class="font-bold text-lg text-blue-700">DAQ-IOT <span class="text-sm font-normal text-slate-500">数采物联</span></a>
    <div class="hidden md:flex items-center gap-6">
      {nav.map((item) => (
        <a href={item.href} class="text-slate-600 hover:text-blue-700 transition">{item.label}</a>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <a href={`${base}/contact`} class="hidden md:inline-flex bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition">{t('nav.cta')}</a>
      <LanguageSwitcher lang={lang} />
    </div>
  </nav>
</header>
