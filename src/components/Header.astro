---
import { getTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getTranslations(lang);
const base = '/' + lang;
const path = Astro.url.pathname;

const categories = [
  { key: 'software', href: base + '/products?cat=software' },
  { key: 'edge', href: base + '/products?cat=edge' },
  { key: 'sensor', href: base + '/products?cat=sensor' },
  { key: 'connect', href: base + '/products?cat=connect' },
  { key: 'auto', href: base + '/products?cat=auto' },
];

const nav = [
  { href: base + '/', label: t('nav.home') },
  { href: base + '/products', label: t('nav.products'), dropdown: categories },
  { href: base + '/solutions', label: t('nav.solutions') },
  { href: base + '/services', label: t('nav.services') },
  { href: base + '/partners', label: t('nav.partners') },
  { href: base + '/support', label: t('nav.support') },
  { href: base + '/about', label: t('nav.about') },
  { href: base + '/contact', label: t('nav.contact') },
];

function isActive(href: string) {
  if (href === base + '/') return path === base + '/' || path === '/' + lang;
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200">
  <nav class="mx-auto max-w-7xl px-4 h-16 flex items-center justify-between gap-4">
    <a href={base + '/'} class="flex items-center gap-2 shrink-0">
      <span class="font-bold text-xl text-brand-dark">DAQ<span class="text-brand">-IOT</span></span>
      <span class="text-xs font-normal text-slate-400 hidden lg:inline">数采物联</span>
    </a>

    <!-- 桌面导航 -->
    <div class="hidden lg:flex items-center gap-1">
      {nav.map((item) => (
        item.dropdown ? (
          <div class="relative group">
            <a href={item.href}
               class={`nav-link inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-slate-700 hover:text-brand transition ${isActive(item.href) ? 'text-brand' : ''}`}>
              {item.label}
              <svg class="w-3 h-3 mt-0.5" viewBox="0 0 12 12" fill="none"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition">
              <div class="w-64 bg-white rounded-xl shadow-xl border border-slate-100 py-2">
                {item.dropdown.map((c) => (
                  <a href={c.href} class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-brand-light hover:text-brand transition">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand shrink-0"></span>
                    {t('cat.' + c.key)}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href}
             class={`nav-link px-3 py-2 text-sm font-medium text-slate-700 hover:text-brand transition ${isActive(item.href) ? 'text-brand' : ''}`}>
            {item.label}
          </a>
        )
      ))}
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <a href={base + '/contact'} class="hidden sm:inline-flex bg-brand text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
      <LanguageSwitcher lang={lang} />
      <!-- 移动端菜单按钮 -->
      <button id="menuBtn" class="lg:hidden p-2 text-slate-700" aria-label="菜单">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </nav>

  <!-- 移动端展开菜单 -->
  <div id="mobileMenu" class="lg:hidden hidden border-t border-slate-200 bg-white max-h-[80vh] overflow-y-auto">
    <div class="mx-auto max-w-7xl px-4 py-3 space-y-1">
      {nav.map((item) => (
        item.dropdown ? (
          <div class="py-1">
            <div class="px-2 py-2 text-sm font-semibold text-slate-900">{item.label}</div>
            <div class="pl-3 grid grid-cols-1">
              {item.dropdown.map((c) => (
                <a href={c.href} class="px-2 py-2 text-sm text-slate-600 hover:text-brand">{t('cat.' + c.key)}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="block px-2 py-2 text-sm font-medium text-slate-700 hover:text-brand">{item.label}</a>
        )
      ))}
      <a href={base + '/contact'} class="block mt-2 text-center bg-brand text-white px-4 py-2.5 rounded-md text-sm font-medium">{t('nav.cta')}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('mobileMenu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
