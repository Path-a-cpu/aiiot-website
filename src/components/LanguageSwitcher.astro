---
import { locales, languages } from '../i18n/config';
import { stripLang } from '../i18n/utils';
import type { Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const pure = stripLang(pathname, lang);
const suffix = pure === '/' ? '/' : pure;
const links = [
  { code: 'en', label: languages['en'], href: '/en' + suffix, active: lang === 'en' },
  { code: 'zh', label: languages['zh'], href: '/zh' + suffix, active: lang === 'zh' },
  { code: 'de', label: languages['de'], href: '/de' + suffix, active: lang === 'de' },
];
---
<div class="flex items-center gap-0.5 text-sm border border-slate-200 rounded-md px-1 py-0.5">
  {links.map((l) => (
    <a
      href={l.href}
      title={l.label}
      class={`px-1.5 py-0.5 rounded uppercase ${l.active ? 'text-blue-700 font-semibold' : 'text-slate-400 hover:text-blue-700'}`}
    >{l.code}</a>
  ))}
</div>
