---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

const families = [
  { key: 'software', href: base + '/products?cat=software' },
  { key: 'edge', href: base + '/products?cat=edge' },
  { key: 'sensor', href: base + '/products?cat=sensor' },
  { key: 'connect', href: base + '/products?cat=connect' },
  { key: 'auto', href: base + '/products?cat=auto' },
];

const industries = (site.home?.industries ?? []).map((it: { label: string }, i: number) => ({
  n: String(i + 1).padStart(2, '0'),
  label: it.label
}));

const stats = (site.home?.stats ?? []).map((s: { value: string; label: string }) => ({
  v: s.value,
  l: s.label
}));
---
<BaseLayout lang={lang} title={t('hero.title') + ' | AIIOT'} description={t('hero.subtitle')}>

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(37,99,235,0.25),transparent_55%),radial-gradient(circle_at_80%_60%,rgba(14,165,233,0.18),transparent_50%)]"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image:url('data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'40\' height=\'40\'><path d=\'M0 39.5H40M39.5 0V40\' fill=\'none\' stroke=\'white\' stroke-width=\'1\'/></svg>')"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-darker via-brand-darker/85 to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 md:py-32">
      <p class="text-brand text-base md:text-lg font-bold tracking-widest uppercase">{t('home.eyebrow')}</p>
      <h1 class="mt-4 text-3xl md:text-5xl font-bold text-white max-w-3xl leading-tight">{t('home.heroTitle')}</h1>
      <p class="mt-6 text-lg text-slate-300 max-w-2xl">{t('home.heroSubtitle')}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={base + '/contact'} class="bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('home.heroCta1')}</a>
        <a href={base + '/products'} class="border border-white/40 text-white px-7 py-3 rounded-md font-medium hover:bg-white/10 transition">{t('home.heroCta2')}</a>
      </div>
    </div>
  </section>

  <!-- 五大产品矩阵 -->
  <section class="mx-auto max-w-7xl px-4 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">{t('home.categoriesTitle')}</h2>
      <p class="mt-3 text-slate-500">{t('home.categoriesSubtitle')}</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {families.map((f) => (
        <a href={f.href} class="card-hover group block bg-white border border-slate-200 rounded-2xl p-6 hover:border-brand">
          <div class="w-12 h-12 rounded-xl bg-brand-light flex items-center justify-center mb-4">
            <span class="text-brand font-bold text-lg">AI+</span>
          </div>
            <h3 class="text-lg font-semibold text-brand-dark group-hover:text-brand transition">{t('cat.' + f.key)}</h3>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">{t('home.catDesc' + f.key.charAt(0).toUpperCase() + f.key.slice(1))}</p>
          <span class="mt-4 inline-flex items-center text-sm font-medium text-brand">{t('home.viewAll')} →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 行业解决方案 -->
  <section class="bg-slate-50 border-y border-slate-100">
    <div class="mx-auto max-w-7xl px-4 py-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-dark">{t('home.solutionsTitle')}</h2>
        <p class="mt-3 text-slate-500">{t('home.solutionsSubtitle')}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {industries.map((it) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-7 card-hover">
            <span class="text-brand/30 text-3xl font-bold">{it.n}</span>
            <h3 class="mt-3 text-xl font-semibold text-brand-dark">{it.label}</h3>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={base + '/solutions'} class="inline-flex items-center gap-2 text-brand font-medium hover:text-brand-dark transition">{t('nav.solutions')} →</a>
      </div>
    </div>
  </section>

  <!-- 数据基石 -->
  <section class="mx-auto max-w-7xl px-4 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-brand-dark">{t('home.statsTitle')}</h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((s) => (
        <div class="text-center">
          <div class="text-4xl md:text-5xl font-bold text-brand">{s.v}</div>
          <div class="mt-2 text-slate-500 text-sm">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 合作伙伴 -->
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white">{t('home.partnersTitle')}</h2>
      <p class="mt-3 text-slate-400">{t('home.partnersSubtitle')}</p>
      <a href={base + '/partners'} class="mt-6 inline-block border border-white/40 text-white px-6 py-2.5 rounded-md text-sm font-medium hover:bg-white/10 transition">{t('nav.partners')} →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center text-white">
      <h2 class="text-3xl font-bold">{t('home.ctaTitle')}</h2>
      <p class="mt-3 text-brand-light">{t('home.ctaSubtitle')}</p>
      <a href={base + '/contact'} class="mt-6 inline-block bg-white text-brand px-7 py-3 rounded-md font-medium hover:bg-brand-light transition">{t('home.ctaButton')}</a>
    </div>
  </section>
</BaseLayout>
