---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const contactHref = '/' + lang + '/contact';
const productsHref = '/' + lang + '/products';
---
<BaseLayout lang={lang} title={t('hero.title') + ' | DAQ-IOT'} description={t('hero.subtitle')}>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-blue-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900">{t('hero.title')}</h1>
      <p class="mt-6 text-lg text-slate-600 max-w-2xl mx-auto">{t('hero.subtitle')}</p>
      <div class="mt-8 flex justify-center gap-4">
        <a href={contactHref} class="bg-blue-600 text-white px-6 py-3 rounded-md font-medium hover:bg-blue-700 transition">{t('hero.ctaPrimary')}</a>
        <a href={productsHref} class="border border-slate-300 text-slate-700 px-6 py-3 rounded-md font-medium hover:border-blue-600 hover:text-blue-700 transition">{t('hero.ctaSecondary')}</a>
      </div>
      <img src="/hero.svg" alt="DAQ-IOT 工业物联网" class="mx-auto mt-10 w-full max-w-4xl rounded-2xl shadow-xl" />
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-slate-900">{t('features.title')}</h2>
      <p class="mt-3 text-slate-500">{t('features.subtitle')}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature1Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature1Desc')}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature2Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature2Desc')}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature3Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature3Desc')}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature4Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature4Desc')}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature5Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature5Desc')}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h3 class="font-semibold text-slate-900">{t('feature6Title')}</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('feature6Desc')}</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-blue-600">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center text-white">
      <h2 class="text-3xl font-bold">{t('cta.title')}</h2>
      <p class="mt-3 text-blue-100">{t('cta.subtitle')}</p>
      <a href={contactHref} class="mt-6 inline-block bg-white text-blue-700 px-6 py-3 rounded-md font-medium hover:bg-blue-50 transition">{t('cta.button')}</a>
    </div>
  </section>
</BaseLayout>
