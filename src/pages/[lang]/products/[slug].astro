---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => {
    const [lang, ...slugParts] = entry.id.split('/');
    const slug = slugParts.join('/');
    return {
      params: { lang, slug },
      props: { entry },
    };
  });
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const { entry } = Astro.props;
const t = await getTranslations(lang);
const { Content } = await render(entry);
const productsHref = '/' + lang + '/products';
const contactHref = '/' + lang + '/contact';
---
<BaseLayout lang={lang} title={entry.data.title + ' | DAQ-IOT'} description={entry.data.summary}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <a href={productsHref} class="inline-flex items-center text-blue-600 hover:text-blue-800 text-sm font-medium">&larr; {t('products.back', '返回产品')}</a>

    <div class="mt-6 grid md:grid-cols-2 gap-8 items-start">
      {entry.data.image && (
        <img src={entry.data.image} alt={entry.data.title} class="w-full h-72 object-cover rounded-xl shadow" />
      )}
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900">{entry.data.title}</h1>
        <p class="mt-4 text-lg text-slate-600">{entry.data.summary}</p>
        <a href={contactHref} class="mt-6 inline-block bg-blue-600 text-white px-6 py-3 rounded-md font-medium hover:bg-blue-700 transition">{t('nav.cta', '获取报价')}</a>
      </div>
    </div>

    <div class="mt-12 border-t border-slate-200 pt-8 text-slate-700 leading-relaxed space-y-4">
      <Content />
    </div>
  </section>
</BaseLayout>
