---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;
---
<BaseLayout lang={lang} title={t('support.title') + ' | DAQ-IOT'} description={t('support.subtitle')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('support.title')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">{t('support.subtitle')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
        <h3 class="text-lg font-semibold text-brand-dark">Documentation</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('support.subtitle')}</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
        <h3 class="text-lg font-semibold text-brand-dark">RMA Services</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('support.subtitle')}</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
        <h3 class="text-lg font-semibold text-brand-dark">Training</h3>
        <p class="mt-2 text-slate-600 text-sm">{t('support.subtitle')}</p>
      </div>
    </div>
    <div class="text-center mt-12">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
