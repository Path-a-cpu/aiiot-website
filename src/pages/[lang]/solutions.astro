---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getSiteData } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const site = await getSiteData(lang);
const base = '/' + lang;

const items = (site.solutions?.items ?? []) as { title: string; desc: string }[];
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<BaseLayout lang={lang} title={t('solutions.title') + ' | AIIOT'} description={t('solutions.subtitle')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('solutions.title')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">{t('solutions.subtitle')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16">
    <p class="text-slate-600 max-w-3xl mb-10">{t('solutions.p1')}</p>
    <div class="grid sm:grid-cols-2 gap-6">
      {items.map((it, idx) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
          <span class="text-brand/30 text-4xl font-bold">{pad(idx)}</span>
          <h3 class="mt-3 text-2xl font-semibold text-brand-dark">{it.title}</h3>
          <p class="mt-3 text-slate-600 leading-relaxed">{it.desc}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-12">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
