---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;

const industries = [
  { n: '01', label: t('home.industry1'), desc: t('solutions.p1') },
  { n: '02', label: t('home.industry2'), desc: t('solutions.p1') },
  { n: '03', label: t('home.industry3'), desc: t('solutions.p1') },
  { n: '04', label: t('home.industry4'), desc: t('solutions.p1') },
];
---
<BaseLayout lang={lang} title={t('solutions.title') + ' | DAQ-IOT'} description={t('solutions.subtitle')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-16">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('solutions.title')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">{t('solutions.subtitle')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16">
    <p class="text-slate-600 max-w-3xl mb-10">{t('solutions.p1')}</p>
    <div class="grid sm:grid-cols-2 gap-6">
      {industries.map((it) => (
        <div class="bg-white border border-slate-200 rounded-2xl p-8 card-hover">
          <span class="text-brand/30 text-4xl font-bold">{it.n}</span>
          <h3 class="mt-3 text-2xl font-semibold text-brand-dark">{it.label}</h3>
        </div>
      ))}
    </div>
    <div class="text-center mt-12">
      <a href={base + '/contact'} class="inline-block bg-brand text-white px-7 py-3 rounded-md font-medium hover:bg-brand-dark transition">{t('nav.cta')}</a>
    </div>
  </section>
</BaseLayout>
