---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const allProducts = await getCollection('products', (entry) => entry.id.startsWith(lang + '/'));
const products = allProducts.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---
<BaseLayout lang={lang} title={t('products.title') + ' | DAQ-IOT'} description={t('products.subtitle')}>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-slate-900">{t('products.title')}</h1>
      <p class="mt-3 text-slate-500">{t('products.subtitle')}</p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      {products.map((p) => (
        <div class="border border-slate-200 rounded-xl p-6 hover:shadow-lg transition">
          {p.data.image && <img src={p.data.image} alt={p.data.title} class="mb-4 w-full h-40 object-cover rounded-lg" />}
          <h3 class="text-xl font-semibold text-slate-900">{p.data.title}</h3>
          <p class="mt-2 text-slate-600">{p.data.summary}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
