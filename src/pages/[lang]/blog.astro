---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
const base = '/' + lang;

const posts = (await getCollection('posts', (entry) => entry.id.startsWith(lang + '/')))
  .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0));

function fmt(d: Date | undefined) {
  return d ? d.toISOString().slice(0, 10) : '';
}
---
<BaseLayout lang={lang} title={t('blog.title') + ' | AIIOT'} description={t('blog.subtitle')}>
  <section class="bg-brand-dark">
    <div class="mx-auto max-w-7xl px-4 py-14">
      <h1 class="text-3xl md:text-4xl font-bold text-white">{t('blog.title')}</h1>
      <p class="mt-3 text-slate-300 max-w-2xl">{t('blog.subtitle')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-10">
    {posts.length === 0 ? (
      <p class="text-slate-500 py-12 text-center">—</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
        {posts.map((p) => (
          <a href={'/' + lang + '/blog/' + p.id.split('/').slice(1).join('/')}
             class="block bg-white border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition">
            {p.data.image && <img src={p.data.image} alt={p.data.title} class="w-full h-48 object-cover bg-slate-50" />}
            <div class="p-6">
              <p class="text-xs text-slate-400">{fmt(p.data.pubDate)}</p>
              <h3 class="mt-2 text-xl font-semibold text-brand-dark">{p.data.title}</h3>
              <p class="mt-2 text-slate-600 text-sm leading-relaxed line-clamp-3">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
