---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

export function getStaticPaths() {
  return (['en', 'zh', 'de'] as Lang[]).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = await getTranslations(lang);
---
<BaseLayout lang={lang} title={t('contact.title') + ' | AIIOT'} description={t('contact.subtitle')}>
  <section class="mx-auto max-w-4xl px-4 py-20">
    <h1 class="text-4xl font-bold text-slate-900">{t('contact.title')}</h1>
    <p class="mt-3 text-slate-500 mb-8">{t('contact.subtitle')}</p>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="space-y-4 text-slate-700">
        <h2 class="text-xl font-semibold text-slate-900">{t('contact.infoTitle')}</h2>
        <p><span class="font-medium">{t('contact.person')}:</span> 王亚乐 (Wang Yale)</p>
        <p><span class="font-medium">{t('contact.email')}:</span> business@x-aiiot.com</p>
        <p><span class="font-medium">{t('contact.phone')}:</span> 400-9677-032</p>
        <p><span class="font-medium">{t('contact.mobile')}:</span> +86 152 7563 5861</p>
        <div>
          <p class="font-medium">{t('contact.address')}:</p>
          <p class="text-sm text-slate-600 mt-1">1. {t('contact.address1')}</p>
          <p class="text-sm text-slate-600">2. {t('contact.address2')}</p>
          <p class="text-sm text-slate-600">3. {t('contact.address3')}</p>
          <p class="text-sm text-slate-600">4. {t('contact.address4')}</p>
          <p class="text-sm text-slate-600">5. {t('contact.address5')}</p>
        </div>
      </div>

      <!--
        web3forms access_key 已配置。
        该 key 于 2026-08-13 重新生成替换旧 key，询盘通知发到生成此 key 时所用邮箱（在 Web3Forms 后台可查）。
        如需更换接收邮箱，用新邮箱重新生成 key 并替换下方 value。
      -->
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value="1a4596ed-4a96-4c5f-8f78-d5045b3fbf52" />
        <input type="hidden" name="subject" value="New Inquiry from AIIOT Website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.name')}</label>
          <input type="text" name="name" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.email')}</label>
          <input type="email" name="email" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.company')}</label>
          <input type="text" name="company" class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">{t('contact.message')}</label>
          <textarea name="message" rows="5" required class="w-full border border-slate-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-md font-medium hover:bg-blue-700 transition">{t('contact.submit')}</button>
      </form>
    </div>
  </section>
</BaseLayout>
